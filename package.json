{
  "name": "branch-player",
  "version": "0.1.0",
  "private": true,
  "description": "Seamless branching (interactive) video playback on Media Source Extensions",
  "type": "module",
  "scripts": {
    "demo-clips": "bash scripts/make-demo-clips.sh",
    "build:media": "node scripts/transcode.mjs demo",
    "dev": "node scripts/server.mjs",
    "setup": "npm run demo-clips && npm run build:media",
    "test:seams": "node scripts/seam-test.mjs 60 \"http://localhost:8080/?story=demo\" --pick"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
